{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "REG Mediation Draft v0.1 — non-authoritative",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "entry",
    "scope",
    "status",
    "intent",
    "upstream_discovery",
    "source_refs",
    "assumptions",
    "candidate_properties",
    "controls",
    "unlinked_evidence_ids",
    "open_questions",
    "profile",
    "profile_status",
    "code_generation",
    "github_publication",
    "review_required",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^reg-mediation-[a-f0-9]{20}$"
    },
    "entry": {
      "enum": [
        "PREVENT",
        "PREPARE"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "status": {
      "enum": [
        "NEEDS_CLARIFICATION",
        "DECLARED_PREMISE_CONFLICT",
        "EVIDENCE_INCOMPLETE",
        "EVIDENCE_REVIEW_REQUIRED"
      ]
    },
    "intent": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 4000
    },
    "upstream_discovery": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "report_id",
            "catalog_version",
            "mode"
          ],
          "properties": {
            "report_id": {
              "type": "string",
              "minLength": 1
            },
            "catalog_version": {
              "type": "string",
              "minLength": 1
            },
            "mode": {
              "enum": [
                "exploratory",
                "contextualized"
              ]
            }
          }
        }
      ]
    },
    "source_refs": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/source_ref"
      }
    },
    "assumptions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "assumption_id",
          "assessment",
          "relationship",
          "source_refs",
          "status"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "assumption_id": {
            "type": "string",
            "minLength": 1
          },
          "assessment": {
            "enum": [
              "open_question",
              "conditional",
              "structural_conflict"
            ]
          },
          "relationship": {
            "enum": [
              "analyst_inference",
              "direct_source_statement",
              "illustrative"
            ]
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/source_ref"
            }
          },
          "status": {
            "const": "DECLARED_NOT_OBSERVED"
          }
        }
      }
    },
    "candidate_properties": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "proposal_id",
          "source_hint",
          "condition",
          "finding_id",
          "status",
          "canonical_invariant_id"
        ],
        "properties": {
          "proposal_id": {
            "type": "string",
            "minLength": 1
          },
          "source_hint": {
            "type": "string",
            "minLength": 1
          },
          "condition": {
            "type": "string",
            "minLength": 1
          },
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "UNREVIEWED_CANDIDATE"
          },
          "canonical_invariant_id": {
            "type": "null"
          }
        }
      }
    },
    "controls": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "control_id",
          "description",
          "evidence_ids_declared",
          "evidence_ids_available",
          "missing_evidence_ids",
          "assessment"
        ],
        "properties": {
          "control_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids_declared": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_ids_available": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "missing_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "assessment": {
            "enum": [
              "MISSING_EVIDENCE",
              "REFERENCED_UNVERIFIED"
            ]
          }
        }
      }
    },
    "unlinked_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "profile": {
      "type": "null"
    },
    "profile_status": {
      "const": "NOT_ADMITTED"
    },
    "code_generation": {
      "const": "NOT_GENERATED"
    },
    "github_publication": {
      "const": "NOT_REQUESTED"
    },
    "review_required": {
      "const": true
    },
    "limitations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "not_legal_advice",
        "not_compliance_assessment",
        "not_implementation_audit",
        "not_effective_guarantee",
        "not_execution_authorization"
      ],
      "properties": {
        "not_legal_advice": {
          "const": true
        },
        "not_compliance_assessment": {
          "const": true
        },
        "not_implementation_audit": {
          "const": true
        },
        "not_effective_guarantee": {
          "const": true
        },
        "not_execution_authorization": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "section"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "entry": {
            "const": "PREVENT"
          }
        },
        "required": [
          "entry"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "NEEDS_CLARIFICATION",
              "DECLARED_PREMISE_CONFLICT"
            ]
          },
          "intent": {
            "type": "string"
          },
          "controls": {
            "maxItems": 0
          },
          "unlinked_evidence_ids": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "entry": {
            "const": "PREPARE"
          }
        },
        "required": [
          "entry"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "EVIDENCE_INCOMPLETE",
              "EVIDENCE_REVIEW_REQUIRED"
            ]
          },
          "intent": {
            "type": "null"
          },
          "upstream_discovery": {
            "type": "null"
          },
          "assumptions": {
            "maxItems": 0
          },
          "candidate_properties": {
            "maxItems": 0
          },
          "controls": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
