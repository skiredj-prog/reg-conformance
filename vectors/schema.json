{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["meta"],
  "anyOf": [{ "required": ["vectors"] }, { "required": ["candidates"] }],
  "additionalProperties": false,
  "definitions": {
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "status"],
        "properties": {
          "id":       { "type": "string" },
          "category": { "enum": ["candidate", "exploratory"] },
          "status":   { "enum": ["proposed", "rejected"] },
          "note":     { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "properties": {
    "meta": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "vectors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "rfc", "category", "property", "intended", "status"],
        "properties": {
          "id":        { "type": "string" },
          "rfc":       { "type": "string" },
          "category":  { "enum": ["core", "commit", "extended", "proposal"] },
          "property":  { "type": "string" },
          "input":     { "type": "string" },
          "intended":  { "type": "string" },
          "expected":  { "type": "string" },
          "status":    { "enum": ["implemented", "specified", "proposal", "lab_validated"] },
          "native":    { "enum": ["PASS", "FAIL", "INCONCLUSIVE", "NOT_APPLICABLE", "ADAPTER_REQUIRED", "IMPLEMENTATION_GAP", null] },
          "observed":  { "type": "string" },
          "reference": { "type": "string" },
          "superseded_by": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        },
        "additionalProperties": false
      }
    },
    "candidates":    { "$ref": "#/definitions/candidates" },
    "non_validated": { "$ref": "#/definitions/candidates" }
  }
}
